rules_version = '2';
// Règles du Terminal du F : chaque membre ne voit que son espace ; seul l'admin active les comptes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isApproved() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true; }

    // Liste des admins : créée à la main dans la console Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Profil de chaque membre.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['name', 'email', 'approved', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();

      // Journal privé du membre, seulement une fois son compte activé.
      match /trades/{tradeId} {
        allow read, write: if signedIn() && request.auth.uid == uid && isApproved();
      }
    }
  }
}
